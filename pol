package spacelift

track if {
    input.push.branch == input.stack.branch
    some f in input.push.affected_files
    relevant(f)
}

propose if {
    some f in input.push.affected_files
    relevant(f)
}

ignore if {
    not track
    not propose
}

relevant(f) if startswith(f, "roles/github_runner/")
relevant(f) if startswith(f, "playbooks/github_runner/")
relevant(f) if startswith(f, "inventories/")
relevant(f) if f == "requirements.yml"
relevant(f) if f == "ansible.cfg"
