#!/usr/bin/env bash
#
# bootstrap-board.sh — provision a Scrumban board in GitHub Projects v2
#
# Creates: the project, custom fields (Status / Class / Estimate / Sprint Points),
# repo link, and the label taxonomy. Idempotent-ish: safe to re-run for labels,
# but it will create a SECOND project if you run it twice. Delete or set
# PROJECT_ID below to skip creation.
#
# PREREQS
#   gh auth login
#   gh auth refresh -s project,read:project,repo,admin:org
#
# USAGE
#   ORG=my-org REPO=my-org/my-repo TITLE="Platform Team Board" ./bootstrap-board.sh
#
set -euo pipefail

ORG="${ORG:?set ORG to your GitHub org login}"
REPO="${REPO:?set REPO as owner/name}"
TITLE="${TITLE:-Team Board}"

say() { printf '\n\033[1;34m==>\033[0m %s\n' "$1"; }

gql() { gh api graphql -f query="$1" "${@:2}"; }

# ---------------------------------------------------------------------------
# 1. Resolve org + repo node IDs
# ---------------------------------------------------------------------------
say "Resolving org and repo node IDs"

ORG_ID=$(gql 'query($login:String!){ organization(login:$login){ id } }' \
  -f login="$ORG" --jq '.data.organization.id')

REPO_OWNER="${REPO%%/*}"
REPO_NAME="${REPO##*/}"
REPO_ID=$(gql 'query($o:String!,$n:String!){ repository(owner:$o,name:$n){ id } }' \
  -f o="$REPO_OWNER" -f n="$REPO_NAME" --jq '.data.repository.id')

echo "org=$ORG_ID repo=$REPO_ID"

# ---------------------------------------------------------------------------
# 2. Create the project
# ---------------------------------------------------------------------------
say "Creating project: $TITLE"

PROJECT_ID=$(gql 'mutation($owner:ID!,$title:String!){
  createProjectV2(input:{ownerId:$owner, title:$title}){ projectV2 { id number } }
}' -f owner="$ORG_ID" -f title="$TITLE" --jq '.data.createProjectV2.projectV2.id')

PROJECT_NUMBER=$(gql 'query($login:String!){
  organization(login:$login){ projectsV2(last:1){ nodes { number } } }
}' -f login="$ORG" --jq '.data.organization.projectsV2.nodes[0].number')

echo "project=$PROJECT_ID number=$PROJECT_NUMBER"
echo "URL: https://github.com/orgs/$ORG/projects/$PROJECT_NUMBER"

# ---------------------------------------------------------------------------
# 3. Link the repo (drives auto-add + issue suggestions)
# ---------------------------------------------------------------------------
say "Linking $REPO to the project"

gql 'mutation($p:ID!,$r:ID!){
  linkProjectV2ToRepository(input:{projectId:$p, repositoryId:$r}){ repository { name } }
}' -f p="$PROJECT_ID" -f r="$REPO_ID" --jq '.data.linkProjectV2ToRepository.repository.name'

# ---------------------------------------------------------------------------
# 4. Reshape the default Status field into real flow states
# ---------------------------------------------------------------------------
say "Reshaping Status into flow states"

STATUS_FIELD_ID=$(gql 'query($p:ID!){
  node(id:$p){ ... on ProjectV2 { fields(first:50){ nodes {
    ... on ProjectV2SingleSelectField { id name } } } } }
}' -f p="$PROJECT_ID" --jq '.data.node.fields.nodes[] | select(.name=="Status") | .id')

gql 'mutation($f:ID!){
  updateProjectV2Field(input:{
    fieldId:$f
    singleSelectOptions:[
      {name:"Backlog",     color:GRAY,   description:"Not committed. Unordered is fine."}
      {name:"Ready",       color:BLUE,   description:"Meets Definition of Ready. Anyone could pick it up."}
      {name:"In Progress", color:YELLOW, description:"Someone is actively on it. WIP limit applies."}
      {name:"In Review",   color:ORANGE, description:"PR open, awaiting review."}
      {name:"Blocked",     color:RED,    description:"Waiting on something external. Needs a reason comment."}
      {name:"Done",        color:GREEN,  description:"Merged and verified."}
    ]
  }){ projectV2Field { ... on ProjectV2SingleSelectField { name } } }
}' -f f="$STATUS_FIELD_ID" --jq '.data.updateProjectV2Field.projectV2Field.name'

# ---------------------------------------------------------------------------
# 5. Custom fields
# ---------------------------------------------------------------------------
say "Creating custom fields"

create_single_select() {
  local name="$1"; shift
  gql 'mutation($p:ID!,$n:String!,$o:[ProjectV2SingleSelectFieldOptionInput!]){
    createProjectV2Field(input:{projectId:$p, dataType:SINGLE_SELECT, name:$n, singleSelectOptions:$o}){
      projectV2Field { ... on ProjectV2SingleSelectField { name } } }
  }' -f p="$PROJECT_ID" -f n="$name" -F o="$1" \
    --jq '.data.createProjectV2Field.projectV2Field.name' || echo "  (skipped $name — may already exist)"
}

# Class of service — drives triage rules later
gql 'mutation($p:ID!){
  createProjectV2Field(input:{
    projectId:$p, dataType:SINGLE_SELECT, name:"Class"
    singleSelectOptions:[
      {name:"Expedite", color:RED,    description:"Drop everything. Prod impact."}
      {name:"Standard", color:BLUE,   description:"Normal feature or bug work."}
      {name:"Chore",    color:GRAY,   description:"Deps, cleanup, docs."}
      {name:"Toil",     color:PURPLE, description:"Manual repeat work. Candidate for automation."}
    ]
  }){ projectV2Field { ... on ProjectV2SingleSelectField { name } } }
}' -f p="$PROJECT_ID" --jq '.data.createProjectV2Field.projectV2Field.name'

# Estimate — number, so Insights can sum it
gql 'mutation($p:ID!){
  createProjectV2Field(input:{projectId:$p, dataType:NUMBER, name:"Estimate"}){
    projectV2Field { ... on ProjectV2Field { name } } }
}' -f p="$PROJECT_ID" --jq '.data.createProjectV2Field.projectV2Field.name'

# Blocked Since — lets the maintenance job measure how long things have been stuck
gql 'mutation($p:ID!){
  createProjectV2Field(input:{projectId:$p, dataType:DATE, name:"Blocked Since"}){
    projectV2Field { ... on ProjectV2Field { name } } }
}' -f p="$PROJECT_ID" --jq '.data.createProjectV2Field.projectV2Field.name'

# ---------------------------------------------------------------------------
# 6. Labels
# ---------------------------------------------------------------------------
say "Creating labels on $REPO"

create_label() {
  gh label create "$1" --repo "$REPO" --color "$2" --description "$3" --force >/dev/null \
    && echo "  $1"
}

create_label "type:bug"      "d73a4a" "Something is broken"
create_label "type:feature"  "0e8a16" "New capability"
create_label "type:chore"    "cfd3d7" "Deps, cleanup, docs"
create_label "type:toil"     "8250df" "Manual repeat work worth automating"
create_label "type:incident" "b60205" "Postmortem follow-up"
create_label "needs:triage"  "fbca04" "Not yet sized or classed"
create_label "needs:info"    "d876e3" "Waiting on the reporter"
create_label "blocked"       "e11d21" "Waiting on something external"
create_label "good-first-pickup" "1d76db" "Well-specified, low context required"

# ---------------------------------------------------------------------------
# Done
# ---------------------------------------------------------------------------
say "Bootstrap complete"
cat <<EOF

  Project: https://github.com/orgs/$ORG/projects/$PROJECT_NUMBER

  Save these for the maintenance workflow:
    PROJECT_ID=$PROJECT_ID
    PROJECT_NUMBER=$PROJECT_NUMBER

  MANUAL STEPS REMAINING (see README — these have no API):
    1. Create the Iteration field  (Settings -> + New field -> Iteration)
    2. Create the three saved views
    3. Turn on built-in workflows + auto-add

EOF
