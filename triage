      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Data volume free %",
      "description": "ALERT #1 -- start here. A full data volume puts GHES into read-only and is the classic outage. Percentage rather than absolute bytes so the rule ports across hosts.",
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 6,
        "h": 7
      },
      "datasource": {
        "type": "graphite",
        "uid": "${DS_GRAPHITE}"
      },
      "targets": [
        {
          "refId": "A",
          "target": "asPercent(collectd.$host.df-data-user.df_complex-free, sumSeries(collectd.$host.df-data-user.df_complex-free, collectd.$host.df-data-user.df_complex-used))",
          "datasource": {
            "type": "graphite",
            "uid": "${DS_GRAPHITE}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 15
              },
              {
                "color": "yellow",
                "value": 25
              },
              {
                "color": "green",
                "value": 40
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Data volume free (GB)",
      "description": "Same signal in absolute terms. Useful for judging headroom and growth rate; percentage is usually the better alert.",
