{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.2",
  "body": [
    {
      "type": "TextBlock",
      "text": "@{coalesce(triggerBody()?['repository']?['full_name'], 'GitHub')}",
      "weight": "Bolder",
      "wrap": true
    },
    {
      "type": "TextBlock",
      "text": "@{coalesce(triggerBody()?['head_commit']?['message'], triggerBody()?['zen'], 'event received')}",
      "wrap": true
    },
    {
      "type": "TextBlock",
      "text": "by @{coalesce(triggerBody()?['sender']?['login'], 'unknown')}",
      "isSubtle": true,
      "wrap": true
    }
  ]
}
