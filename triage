#!/usr/bin/env bash
#
# teams-workflow-test.sh
#
# Diagnostic ladder for a Power Automate "When a Teams webhook request is
# received" trigger. Runs four escalating tests so you can tell exactly WHERE
# a failure is, instead of just that one occurred.
#
#   Test 1  Minimal Adaptive Card ....... is the pipe open at all?
#   Test 2  Alert-shaped Adaptive Card .. does real formatting render?
#   Test 3  Legacy MessageCard .......... will old tooling drop in unchanged?
#   Test 4  Raw Azure Monitor payload ... EXPECTED TO FAIL (see notes below)
#
# Usage:
#   ./teams-workflow-test.sh "https://prod-XX.usgovvirginia.logic.azure.us:443/workflows/..."
#   TEAMS_WEBHOOK_URL="https://..." ./teams-workflow-test.sh
#
#   Run a single test:  ./teams-workflow-test.sh "<url>" 3
#
# IMPORTANT: if your trigger is set to "Anyone", do NOT send an Authorization
# header. Power Automate rejects the request outright if one is present.
# If you set it to "Any user in my tenant", you must send a bearer token --
# uncomment AUTH_HEADER below and supply one.

set -uo pipefail

URL="${1:-${TEAMS_WEBHOOK_URL:-}}"
ONLY="${2:-all}"

# AUTH_HEADER=(-H "Authorization: Bearer ${TEAMS_WEBHOOK_TOKEN:-}")
AUTH_HEADER=()

if [[ -z "$URL" ]]; then
  echo "ERROR: no webhook URL supplied." >&2
  echo "Usage: $0 \"<workflow-url>\" [1|2|3|4|all]" >&2
  exit 2
fi

case "$URL" in
  https://*.logic.azure.us*)  CLOUD="Azure Government (expected for GCC High / DoD)" ;;
  https://*.logic.azure.com*) CLOUD="Commercial / GCC" ;;
  https://outlook.office*)    CLOUD="!! LEGACY O365 CONNECTOR -- retired May 2026, this will not work" ;;
  *)                          CLOUD="unrecognised endpoint -- double-check you copied the trigger URL" ;;
esac

PASS=0; FAIL=0; TMP="$(mktemp)"
trap 'rm -f "$TMP"' EXIT

hr() { printf '%s\n' "------------------------------------------------------------"; }

post() {
  local num="$1" name="$2" payload="$3" expect_ok="$4" note="$5"

  if [[ "$ONLY" != "all" && "$ONLY" != "$num" ]]; then return 0; fi

  hr
  printf 'Test %s: %s\n' "$num" "$name"

  local start code elapsed
  start=$(date +%s%N)
  code=$(curl -sS --max-time 30 \
           -o "$TMP" -w '%{http_code}' \
           -X POST "$URL" \
           -H 'Content-Type: application/json' \
           "${AUTH_HEADER[@]}" \
           --data-binary "$payload" 2>"$TMP.err") || code="000"
  elapsed=$(( ($(date +%s%N) - start) / 1000000 ))

  printf '  HTTP %s   (%sms)\n' "$code" "$elapsed"

  case "$code" in
    200|201|202)
      if [[ "$expect_ok" == "yes" ]]; then
        printf '  RESULT: PASS -- check the Teams channel for the message.\n'; PASS=$((PASS+1))
      else
        printf '  RESULT: unexpected success. %s\n' "$note"; PASS=$((PASS+1))
      fi
      ;;
    400)
      printf '  RESULT: 400 Bad Request -- payload shape rejected by the trigger.\n'
      [[ "$expect_ok" == "no" ]] && printf '  This is the EXPECTED outcome here. %s\n' "$note"
      FAIL=$((FAIL+1))
      ;;
    401|403)
      # A TLS-inspecting corporate proxy also returns 403, and it looks
      # identical to a Power Automate auth rejection. Distinguish by body.
      if grep -qiE 'allowlist|denied by policy|proxy|blocked|forbidden by|not permitted|egress' "$TMP" 2>/dev/null; then
        printf '  RESULT: 403 from a PROXY, not from Power Automate.\n' 
        printf '          Something on the network path is blocking the request before it\n'
        printf '          leaves. Get *.logic.azure.us allowlisted for egress. Read the\n'
        printf '          body below -- it is usually the proxy telling you exactly why.\n'
      else
        printf '  RESULT: auth rejected by Power Automate. If the trigger is set to\n'
        printf '          "Anyone", make sure you are NOT sending an Authorization header.\n'
        printf '          If it is tenant-scoped, you must send a valid bearer token.\n'
      fi
      FAIL=$((FAIL+1))
      ;;
    404)
      printf '  RESULT: 404 -- URL wrong, or the flow was deleted / turned off.\n'
      FAIL=$((FAIL+1))
      ;;
    429)
      printf '  RESULT: 429 throttled -- you hit the Power Automate performance\n'
      printf '          profile limit. Relevant if you plan to fan alerts in.\n'
      FAIL=$((FAIL+1))
      ;;
    000)
      printf '  RESULT: no response. Egress blocked, DNS, TLS interception, or proxy.\n'
      printf '          From an Azure Gov subnet this is the most common first failure.\n'
      sed 's/^/          /' "$TMP.err" 2>/dev/null | head -5
      FAIL=$((FAIL+1))
      ;;
    *)
      printf '  RESULT: unexpected status.\n'; FAIL=$((FAIL+1))
      ;;
  esac

  if [[ -s "$TMP" ]]; then
    printf '  Body: '; head -c 400 "$TMP"; printf '\n'
  fi
  rm -f "$TMP.err"
}

echo
hr
printf 'Power Automate / Teams webhook diagnostic\n'
printf 'Endpoint looks like: %s\n' "$CLOUD"
hr

# --- Test 1: minimal adaptive card -----------------------------------------
read -r -d '' T1 <<'JSON'
{
  "type": "message",
  "attachments": [
    {
      "contentType": "application/vnd.microsoft.card.adaptive",
      "contentUrl": null,
      "content": {
        "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
        "type": "AdaptiveCard",
        "version": "1.2",
        "body": [
          { "type": "TextBlock", "text": "Test 1 - pipe is open", "weight": "Bolder" }
        ]
      }
    }
  ]
}
JSON

