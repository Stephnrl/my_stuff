# denominator: accounts in the org
aws organizations list-accounts --query 'Accounts[?Status==`ACTIVE`].Id' --output text | wc -w

# GuardDuty coverage
DET=$(aws guardduty list-detectors --query 'DetectorIds[0]' --output text)
aws guardduty list-members --detector-id "$DET" \
  --query 'Members[?RelationshipStatus==`Enabled`].AccountId' --output text | wc -w
aws guardduty describe-organization-configuration --detector-id "$DET" \
  --query 'AutoEnableOrganizationMembers'

# Config coverage + rule count
aws configservice describe-configuration-aggregators
aws configservice get-aggregate-discovered-resource-counts \
  --configuration-aggregator-name <name> --query 'totalDiscoveredResources'
aws configservice describe-config-rules --query 'length(ConfigRules)'

# IAM Access Analyzer — findings is a great "things I now detect" number
aws accessanalyzer list-analyzers --type ORGANIZATION
aws accessanalyzer list-findings --analyzer-arn <arn> \
  --filter '{"status":{"eq":["ACTIVE"]}}' --query 'length(findings)'

# delegated admin services (your shell script already does this)
aws organizations list-delegated-services-for-account --account-id <security-acct>
