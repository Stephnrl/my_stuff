# per-workspace resource count
for d in $(find . -name '.terraform' -type d | xargs -n1 dirname); do
  n=$(terraform -chdir="$d" state list 2>/dev/null | wc -l)
  echo "$n $d"
done | sort -rn

# total, and unique resource types (shows breadth, not just volume)
terraform state list | wc -l
terraform state list | cut -d. -f1 | sort -u | wc -l

