def test_finding_key_ignores_installed_version():
    """Patching a package without fixing the CVE must keep the same POA&M item."""
    a = Finding(vuln_id="CVE-2024-1", pkg_name="openssl", target="os:debian", installed_version="3.0.1")
    b = Finding(vuln_id="CVE-2024-1", pkg_name="openssl", target="os:debian", installed_version="3.0.2")
    assert a.finding_key == b.finding_key


def test_finding_key_separates_same_cve_in_different_packages():
    a = Finding(vuln_id="CVE-2024-1", pkg_name="openssl", target="os:debian")
    b = Finding(vuln_id="CVE-2024-1", pkg_name="libssl", target="os:debian")
    assert a.finding_key != b.finding_key


def test_os_target_normalization_strips_image_tag():
    """The regression that would silently break every diff."""
    r1 = trivy_report([vuln("CVE-2024-1", "openssl", "3.0.1", "CRITICAL")], image_tag="v1.0.0")
    r2 = trivy_report([vuln("CVE-2024-1", "openssl", "3.0.1", "CRITICAL")], image_tag="v9.9.9-rc4+build77")
    f1 = normalize.findings_from_trivy(r1)[0]
    f2 = normalize.findings_from_trivy(r2)[0]
    assert f1.target == "os:debian"
    assert f1.finding_key == f2.finding_key


