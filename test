def base_policy(**overrides):
    pol = json.loads(json.dumps(policy_mod.DEFAULT_POLICY))
    pol.update(overrides)
    return pol


def test_new_critical_fails_the_gate():
    findings = normalize.findings_from_trivy(trivy_report([vuln("CVE-2024-1", "openssl", "3.0.1", "CRITICAL")]))
    result, _ = diff_mod.reconcile(findings, [], meta(), SLA)
    decision = policy_mod.evaluate(result, base_policy())
    assert decision.result == "fail"
    assert decision.violations[0]["rule"] == "new"


def test_new_critical_with_deviation_passes(tmp_path):
    findings = normalize.findings_from_trivy(trivy_report([vuln("CVE-2024-1", "openssl", "3.0.1", "CRITICAL")]))
    result, _ = diff_mod.reconcile(findings, [], meta(), SLA)
    future = (date.today() + timedelta(days=30)).isoformat()
    p = write_exceptions(tmp_path, [{
        "component_id": "org/repo/*", "vuln_id": "CVE-2024-1",
        "justification": "compensating control", "approved_by": "sec-team", "expires_on": future,
    }])
    excs, _ = policy_mod.load_exceptions([p])
    policy_mod.apply_exceptions(result.all_records, excs, "org/repo/api", policy_mod.DEFAULT_POLICY)
    decision = policy_mod.evaluate(result, base_policy())
    assert decision.result == "pass"


def test_bypass_converts_fail_to_pass_with_bypass():
    findings = normalize.findings_from_trivy(trivy_report([vuln("CVE-2024-1", "openssl", "3.0.1", "CRITICAL")]))
    result, _ = diff_mod.reconcile(findings, [], meta(), SLA)
    decision = policy_mod.evaluate(
        result, base_policy(), bypass=True, bypass_reason="prod outage", bypass_actor="alice"
    )
    assert decision.result == "pass_with_bypass"
    assert decision.failed is False
    assert decision.bypass_used is True
    assert decision.violations                    # violations still recorded
    assert decision.bypass_actor == "alice"


def test_grace_period_defers_new_finding():
    findings = normalize.findings_from_trivy(trivy_report([vuln("CVE-2024-1", "openssl", "3.0.1", "CRITICAL")]))
    result, _ = diff_mod.reconcile(findings, [], meta(), SLA)
    decision = policy_mod.evaluate(result, base_policy(grace_period_days=7))
    assert decision.result == "pass"
    assert decision.warnings


def test_overdue_item_fails_even_though_not_new():
    old = (date.today() - timedelta(days=60)).isoformat()
