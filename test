    past = (date.today() - timedelta(days=1)).isoformat()
    p = write_exceptions(tmp_path, [{
        "component_id": "org/repo/api", "vuln_id": "CVE-2024-1",
        "justification": "stale", "approved_by": "sec-team", "expires_on": past,
    }])
    excs, _ = policy_mod.load_exceptions([p])
    report = policy_mod.apply_exceptions(result.all_records, excs, "org/repo/api", policy_mod.DEFAULT_POLICY)

    assert report["applied"] == 0
    assert len(report["expired"]) == 1
    assert result.all_records[0].gating is True


