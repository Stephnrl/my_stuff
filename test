from poam.models import STATUS_CLOSED, STATUS_OPEN, Finding, PoamRecord, ScanMeta

SLA = {"CRITICAL": 30, "HIGH": 30, "MEDIUM": 90, "LOW": 180, "DEFAULT": 90}


def meta(tag: str = "v1.0.0", digest: str = "sha256:aaa") -> ScanMeta:
    return ScanMeta(component_id="org/repo/api", image_tag=tag, image_digest=digest)


def trivy_report(vulns: list[dict], image_tag: str = "v1.0.0", os_family: str = "debian") -> dict:
    return {
        "SchemaVersion": 2,
        "ArtifactName": f"myacr.azurecr.us/team/api:{image_tag}",
        "Results": [
            {
                "Target": f"myacr.azurecr.us/team/api:{image_tag} ({os_family} 12.1)",
                "Class": "os-pkgs",
                "Type": os_family,
                "Vulnerabilities": vulns,
            }
        ],
    }


def vuln(cve: str, pkg: str, installed: str, severity: str, fixed: str = "", score: float = 9.1) -> dict:
    return {
        "VulnerabilityID": cve,
        "PkgName": pkg,
        "InstalledVersion": installed,
        "FixedVersion": fixed,
        "Severity": severity,
        "Title": f"{pkg} flaw",
        "PrimaryURL": f"https://avd.aquasec.com/nvd/{cve.lower()}",
        "Status": "fixed" if fixed else "affected",
        "CVSS": {"nvd": {"V3Score": score, "V3Vector": "CVSS:3.1/AV:N/AC:L"}},
    }


