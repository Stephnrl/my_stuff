def test_state_survives_round_trip(tmp_path):
    findings = normalize.findings_from_trivy(trivy_report([vuln("CVE-2024-1", "openssl", "3.0.1", "CRITICAL")]))
    result, seq = diff_mod.reconcile(findings, [], meta(), SLA)
    store = store_mod.LocalStore(str(tmp_path))

    doc = store_mod.StateDocument(component_id="org/repo/api", records=result.all_records, next_seq=seq)
    doc.scan_count = 1
    store.write_state(doc)

    reloaded = store.read_state("org/repo/api")
    assert reloaded.next_seq == seq
    assert reloaded.scan_count == 1
    assert len(reloaded.records) == 1
    assert reloaded.records[0].finding_key == result.all_records[0].finding_key
    assert reloaded.records[0].scheduled_completion_date == result.all_records[0].scheduled_completion_date


def test_empty_state_for_unknown_component(tmp_path):
    store = store_mod.LocalStore(str(tmp_path))
    doc = store.read_state("never/seen/before")
    assert doc.records == [] and doc.scan_count == 0 and doc.next_seq == 1


def test_component_slug_is_path_safe():
    assert store_mod.component_slug("org/repo/api") == "org/repo/api"
    assert ".." not in store_mod.component_slug("../../etc/passwd")
    assert store_mod.component_slug("org/repo:weird name") == "org/repo-weird-name"
    assert store_mod.component_slug("../../etc/passwd") == "etc/passwd"
    assert store_mod.component_slug("a/../b") == "a/b"
    assert store_mod.component_slug("///") == "unknown"


