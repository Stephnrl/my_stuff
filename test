def test_initial_scan_creates_new_items():
    findings = normalize.findings_from_trivy(
        trivy_report([
            vuln("CVE-2024-1", "openssl", "3.0.1", "CRITICAL", fixed="3.0.2"),
            vuln("CVE-2024-2", "zlib", "1.2.11", "HIGH"),
        ])
    )
    result, next_seq = diff_mod.reconcile(findings, [], meta(), SLA, next_seq=1)
    assert len(result.new) == 2
    assert result.closed == [] and result.reopened == []
    assert next_seq == 3
    assert {r.poam_id for r in result.new} == {"ORG-REPO-API-0001", "ORG-REPO-API-0002"}
    assert all(r.status == STATUS_OPEN for r in result.new)


def test_second_scan_closes_remediated_finding():
    first = normalize.findings_from_trivy(
        trivy_report([
            vuln("CVE-2024-1", "openssl", "3.0.1", "CRITICAL", fixed="3.0.2"),
            vuln("CVE-2024-2", "zlib", "1.2.11", "HIGH"),
        ])
    )
    r1, seq = diff_mod.reconcile(first, [], meta(), SLA)

    # openssl patched; CVE-2024-1 gone. zlib unchanged.
    second = normalize.findings_from_trivy(
        trivy_report([vuln("CVE-2024-2", "zlib", "1.2.11", "HIGH")], image_tag="v1.1.0")
    )
    r2, _ = diff_mod.reconcile(second, r1.all_records, meta("v1.1.0", "sha256:bbb"), SLA, next_seq=seq)

    assert len(r2.closed) == 1
    assert r2.closed[0].vuln_id == "CVE-2024-1"
    assert r2.closed[0].status == STATUS_CLOSED
    assert r2.closed[0].closed_date
    assert len(r2.persisting) == 1
    assert len(r2.new) == 0
    # Closed items are retained, never deleted.
    assert len(r2.all_records) == 2


def test_persisting_finding_keeps_original_due_date():
    """The remediation clock must not reset just because we rebuilt."""
    first = normalize.findings_from_trivy(
        trivy_report([vuln("CVE-2024-1", "openssl", "3.0.1", "CRITICAL", fixed="3.0.2")])
    )
    old = date.today() - timedelta(days=45)
    r1, seq = diff_mod.reconcile(first, [], meta(), SLA, as_of=old.isoformat())
    original_due = r1.new[0].scheduled_completion_date

    # Package bumped, CVE persists.
    second = normalize.findings_from_trivy(
        trivy_report([vuln("CVE-2024-1", "openssl", "3.0.5", "CRITICAL", fixed="3.0.9")])
    )
    r2, _ = diff_mod.reconcile(second, r1.all_records, meta(), SLA, next_seq=seq)

    rec = r2.persisting[0]
    assert rec.scheduled_completion_date == original_due
    assert rec.first_detected == old.isoformat()
    assert rec.installed_version == "3.0.5"   # mutable attribute updated
    assert rec.fixed_version == "3.0.9"
    assert rec.is_overdue()                    # 45 days > 30-day CRITICAL SLA


def test_reopened_finding_increments_counter():
    first = normalize.findings_from_trivy(trivy_report([vuln("CVE-2024-1", "openssl", "3.0.1", "HIGH")]))
    r1, seq = diff_mod.reconcile(first, [], meta(), SLA)

    r2, seq = diff_mod.reconcile([], r1.all_records, meta(), SLA, next_seq=seq)
    assert len(r2.closed) == 1

    r3, _ = diff_mod.reconcile(first, r2.all_records, meta(), SLA, next_seq=seq)
    assert len(r3.reopened) == 1
    assert len(r3.new) == 0                    # a regression is NOT a new POA&M ID
    assert r3.reopened[0].reopened_count == 1
    assert r3.reopened[0].status == STATUS_OPEN
    assert r3.reopened[0].closed_date == ""
    assert r3.reopened[0].poam_id == r1.new[0].poam_id


def test_poam_ids_are_never_reused():
    f1 = normalize.findings_from_trivy(trivy_report([vuln("CVE-2024-1", "a", "1", "LOW")]))
    r1, seq = diff_mod.reconcile(f1, [], meta(), SLA)
    r2, seq = diff_mod.reconcile([], r1.all_records, meta(), SLA, next_seq=seq)
    f3 = normalize.findings_from_trivy(trivy_report([vuln("CVE-2024-2", "b", "1", "LOW")]))
    r3, _ = diff_mod.reconcile(f3, r2.all_records, meta(), SLA, next_seq=seq)
    ids = {r.poam_id for r in r3.all_records}
    assert ids == {"ORG-REPO-API-0001", "ORG-REPO-API-0002"}


def test_severity_escalation_tightens_deadline():
    # 40 days elapsed: inside the 90-day MEDIUM window, past the 30-day CRITICAL one.
    old = (date.today() - timedelta(days=40)).isoformat()
    first = normalize.findings_from_trivy(trivy_report([vuln("CVE-2024-1", "openssl", "3.0.1", "MEDIUM")]))
    r1, seq = diff_mod.reconcile(first, [], meta(), SLA, as_of=old)
    assert r1.new[0].scheduled_completion_date == (date.fromisoformat(old) + timedelta(days=90)).isoformat()
    assert r1.new[0].is_overdue() is False   # MEDIUM: still inside its window

    second = normalize.findings_from_trivy(trivy_report([vuln("CVE-2024-1", "openssl", "3.0.1", "CRITICAL")]))
    r2, _ = diff_mod.reconcile(second, r1.all_records, meta(), SLA, next_seq=seq)

    assert len(r2.severity_drift) == 1
    assert r2.severity_drift[0]["escalation"] is True
    rec = r2.persisting[0]
    # Due date re-derived from ORIGINAL detection, not from today.
    assert rec.scheduled_completion_date == (date.fromisoformat(old) + timedelta(days=30)).isoformat()
    assert rec.is_overdue()
    assert rec.original_severity == "MEDIUM"


