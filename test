def test_workbook_renders_with_expected_sheets(tmp_path):
    from openpyxl import load_workbook

    findings = normalize.findings_from_trivy(trivy_report([
        vuln("CVE-2024-1", "openssl", "3.0.1", "CRITICAL", fixed="3.0.2"),
        vuln("CVE-2024-2", "zlib", "1.2.11", "HIGH"),
    ]))
    result, _ = diff_mod.reconcile(findings, [], meta(), SLA)
    decision = policy_mod.evaluate(result, base_policy())
    data = render.render_poam(result.all_records, result, meta(), decision)

    out = tmp_path / "poam.xlsx"
    out.write_bytes(data)
    wb = load_workbook(out)
    assert wb.sheetnames[0] == "Summary"
    for sheet in ("POA&M Items", "Closed Items", "Change Log", "Deviations", "Gate Violations"):
        assert sheet in wb.sheetnames

    ws = wb["POA&M Items"]
    assert ws["A1"].value == "POA&M ID"
    assert ws["C1"].value == "Severity"
    assert ws["P1"].value == "Deviation Type"   # summary COUNTIFS depends on column P
    assert ws.max_row == 3
    assert ws.freeze_panes == "E2"
