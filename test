    r2, _ = diff_mod.reconcile(findings, r1.all_records, meta(), SLA, next_seq=seq)
    decision = policy_mod.evaluate(r2, base_policy())
    assert decision.result == "fail"
    assert decision.violations[0]["rule"] == "overdue"


def test_reopened_rule_can_fail_regressions():
    findings = normalize.findings_from_trivy(trivy_report([vuln("CVE-2024-1", "openssl", "3.0.1", "HIGH")]))
    r1, seq = diff_mod.reconcile(findings, [], meta(), SLA)
    r2, seq = diff_mod.reconcile([], r1.all_records, meta(), SLA, next_seq=seq)
    r3, _ = diff_mod.reconcile(findings, r2.all_records, meta(), SLA, next_seq=seq)
    pol = base_policy()
    pol["fail_on"] = {"new": [], "overdue": [], "reopened": ["HIGH"], "escalated_into": []}
    decision = policy_mod.evaluate(r3, pol)
    assert decision.result == "fail"
    assert decision.violations[0]["rule"] == "reopened"


