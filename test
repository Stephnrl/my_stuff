def write_exceptions(tmp_path: Path, entries: list[dict]) -> Path:
    import yaml

    p = tmp_path / "exceptions.yaml"
    p.write_text(yaml.safe_dump({"exceptions": entries}), encoding="utf-8")
    return p


def test_exception_marks_deviation_without_hiding_finding(tmp_path):
    findings = normalize.findings_from_trivy(
        trivy_report([vuln("CVE-2024-1", "openssl", "3.0.1", "CRITICAL")])
    )
    result, _ = diff_mod.reconcile(findings, [], meta(), SLA)
    future = (date.today() + timedelta(days=30)).isoformat()
    p = write_exceptions(tmp_path, [{
        "component_id": "org/repo/api",
        "vuln_id": "CVE-2024-1",
        "deviation_type": "Risk Adjusted",
        "justification": "Not reachable; TLS terminated upstream",
        "approved_by": "sec-team",
        "expires_on": future,
        "ref": "DR-101",
    }])
    excs, errors = policy_mod.load_exceptions([p])
    assert errors == []

    report = policy_mod.apply_exceptions(result.all_records, excs, "org/repo/api", policy_mod.DEFAULT_POLICY)
    rec = result.all_records[0]

    assert report["applied"] == 1
    assert rec.status == STATUS_OPEN          # still open, still visible
    assert rec.deviation_type == "Risk Adjusted"
    assert rec.gating is False                 # but not counted by the gate
    assert "Risk Adjusted" in rec.poam_status


def test_expired_exception_stops_suppressing(tmp_path):
    findings = normalize.findings_from_trivy(
        trivy_report([vuln("CVE-2024-1", "openssl", "3.0.1", "CRITICAL")])
    )
