#!/usr/bin/env bash
#
# bootstrap-kanban-board.sh
#
# Creates a GitHub Projects v2 board configured for the DevSecOps Kanban
# system design: Definition of Workflow states, Work Item Types, Classes of
# Service, and the date fields required for cycle-time measurement.
#
# Requires: gh >= 2.40, jq
# Scopes:   gh auth refresh -s project -s read:project
#
# Usage:
#   ./bootstrap-kanban-board.sh --owner my-org --title "DevSecOps Kanban"
#   ./bootstrap-kanban-board.sh --owner @me --title "Shadow Board" --dry-run
#   ./bootstrap-kanban-board.sh --owner my-org --project 12   # add fields to existing
#
set -euo pipefail

OWNER=""
TITLE="DevSecOps Kanban"
PROJECT_NUMBER=""
LINK_REPO=""
DRY_RUN=false

# ---------------------------------------------------------------------------
# Field definitions — edit these to change the board schema
# ---------------------------------------------------------------------------

# Definition of Workflow. Order matters: this is left-to-right on the board.
# Format: Name|Color
DOW_STATES=(
  "Triage|GRAY"
  "Ready|BLUE"
  "In Progress|YELLOW"
  "Blocked / Waiting|RED"
  "In Review|PURPLE"
  "Done|GREEN"
)

WORK_ITEM_TYPES="Escalation,Service Request,Platform Build,Automation Initiative,AI Enablement,Security & Compliance,Toil Reduction"
CLASSES_OF_SERVICE="Expedite,Fixed Date,Standard,Intangible"
WORKSTREAMS="Platform,AI,Automation,Requests,Escalations"
BLOCKED_REASONS="External team,Vendor,Access / permissions,Change approval,Upstream defect,Awaiting customer,Other"

# ---------------------------------------------------------------------------
# Plumbing
# ---------------------------------------------------------------------------

c_bold=$'\033[1m'; c_dim=$'\033[2m'; c_red=$'\033[31m'
c_green=$'\033[32m'; c_yellow=$'\033[33m'; c_reset=$'\033[0m'

log()  { printf '%s==>%s %s\n' "$c_bold" "$c_reset" "$*"; }
ok()   { printf '  %s✓%s %s\n' "$c_green" "$c_reset" "$*"; }
skip() { printf '  %s·%s %s %s(exists)%s\n' "$c_dim" "$c_reset" "$*" "$c_dim" "$c_reset"; }
warn() { printf '  %s!%s %s\n' "$c_yellow" "$c_reset" "$*" >&2; }
die()  { printf '%serror:%s %s\n' "$c_red" "$c_reset" "$*" >&2; exit 1; }

usage() {
  sed -n '3,16p' "$0" | sed 's/^# \{0,1\}//'
  cat <<'OPTS'

Options:
  -o, --owner    <owner>   Org, user, or @me  (required)
  -t, --title    <title>   Project title      (default: DevSecOps Kanban)
  -p, --project  <number>  Add fields to an existing project instead
  -r, --repo     <o/repo>  Link a repository to the project
  -n, --dry-run            Print planned actions, change nothing
  -h, --help               This message
OPTS
  exit "${1:-0}"
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -o|--owner)    OWNER="${2:?--owner requires a value}"; shift 2 ;;
    -t|--title)    TITLE="${2:?--title requires a value}"; shift 2 ;;
    -p|--project)  PROJECT_NUMBER="${2:?--project requires a value}"; shift 2 ;;
    -r|--repo)     LINK_REPO="${2:?--repo requires a value}"; shift 2 ;;
    -n|--dry-run)  DRY_RUN=true; shift ;;
    -h|--help)     usage 0 ;;
    *)             die "unknown argument: $1 (try --help)" ;;
  esac
done

[[ -n "$OWNER" ]] || die "--owner is required (an org, a user, or @me)"

# ---------------------------------------------------------------------------
# Preflight
# ---------------------------------------------------------------------------

log "Preflight checks"

command -v gh >/dev/null 2>&1 || die "gh CLI not found — https://cli.github.com"
command -v jq >/dev/null 2>&1 || die "jq not found"

gh auth status >/dev/null 2>&1 || die "not authenticated — run: gh auth login"

if ! gh auth status 2>&1 | grep -qi 'project'; then
  die "missing the 'project' scope — run: gh auth refresh -s project -s read:project"
fi
ok "gh authenticated with project scope"

if $DRY_RUN; then
  warn "dry run — no changes will be made"
fi

# ---------------------------------------------------------------------------
# Create or adopt the project
# ---------------------------------------------------------------------------

if [[ -n "$PROJECT_NUMBER" ]]; then
  log "Adopting existing project #$PROJECT_NUMBER"
  project_json=$(gh project view "$PROJECT_NUMBER" --owner "$OWNER" --format json) \
    || die "cannot read project #$PROJECT_NUMBER for owner $OWNER"
  PROJECT_URL=$(jq -r '.url' <<<"$project_json")
  ok "$(jq -r '.title' <<<"$project_json") — $PROJECT_URL"
else
  log "Creating project: $TITLE"
  if $DRY_RUN; then
    ok "would create project '$TITLE' under $OWNER"
    PROJECT_NUMBER="DRYRUN"
    PROJECT_URL="(dry run)"
  else
    project_json=$(gh project create --owner "$OWNER" --title "$TITLE" --format json) \
      || die "project creation failed"
    PROJECT_NUMBER=$(jq -r '.number' <<<"$project_json")
    PROJECT_URL=$(jq -r '.url' <<<"$project_json")
    ok "created project #$PROJECT_NUMBER — $PROJECT_URL"
  fi
fi

# Cache the field list once; refreshed after each mutation batch.
refresh_fields() {
  $DRY_RUN && { FIELDS_JSON='{"fields":[]}'; return 0; }
  FIELDS_JSON=$(gh project field-list "$PROJECT_NUMBER" --owner "$OWNER" --limit 100 --format json)
}

field_exists() {
  jq -e --arg n "$1" '.fields[] | select(.name == $n)' <<<"$FIELDS_JSON" >/dev/null 2>&1
}

field_id() {
  jq -r --arg n "$1" '.fields[] | select(.name == $n) | .id' <<<"$FIELDS_JSON"
}

refresh_fields

# ---------------------------------------------------------------------------
# Rewrite the built-in Status field to the Definition of Workflow
# ---------------------------------------------------------------------------
#
# Every new project ships with Status = Todo / In Progress / Done. We replace
# the option set wholesale via GraphQL, since gh has no subcommand for it.
# Replacing options on a board that already has items assigned to the old
# options will clear those assignments — safe on a fresh board only.

log "Setting Status field to the Definition of Workflow"

if $DRY_RUN; then
  for entry in "${DOW_STATES[@]}"; do ok "would set state: ${entry%%|*}"; done
else
  STATUS_FIELD_ID=$(field_id "Status")
  if [[ -z "$STATUS_FIELD_ID" || "$STATUS_FIELD_ID" == "null" ]]; then
    warn "no built-in Status field found — skipping DoW rewrite"
  else
    options_json="[]"
    for entry in "${DOW_STATES[@]}"; do
      name="${entry%%|*}"
      color="${entry##*|}"
      options_json=$(jq -c \
        --arg name "$name" --arg color "$color" \
        '. + [{name: $name, color: $color, description: ""}]' <<<"$options_json")
    done

    gh api graphql -f query='
      mutation($fieldId: ID!, $options: [ProjectV2SingleSelectFieldOptionInput!]!) {
        updateProjectV2Field(input: { fieldId: $fieldId, singleSelectOptions: $options }) {
          projectV2Field { ... on ProjectV2SingleSelectField { id name } }
        }
      }' \
      -f fieldId="$STATUS_FIELD_ID" \
      --field options="$options_json" >/dev/null \
      && ok "Status → $(printf '%s, ' "${DOW_STATES[@]%%|*}" | sed 's/, $//')" \
      || warn "could not rewrite Status options — set them manually in the UI"
  fi
fi

# ---------------------------------------------------------------------------
# Custom fields
# ---------------------------------------------------------------------------

create_field() {
  local name="$1" type="$2" options="${3:-}"

  if field_exists "$name"; then
    skip "$name"
    return 0
  fi

  if $DRY_RUN; then
    ok "would create $name ($type)"
    return 0
  fi

  local args=(project field-create "$PROJECT_NUMBER"
              --owner "$OWNER" --name "$name" --data-type "$type")
  [[ -n "$options" ]] && args+=(--single-select-options "$options")

  if gh "${args[@]}" >/dev/null 2>&1; then
    ok "$name ($type)"
  else
    warn "failed to create '$name' — create it manually"
  fi
}

log "Creating classification fields"
create_field "Work Item Type"   SINGLE_SELECT "$WORK_ITEM_TYPES"
create_field "Class of Service" SINGLE_SELECT "$CLASSES_OF_SERVICE"
create_field "Workstream"       SINGLE_SELECT "$WORKSTREAMS"
create_field "Blocked Reason"   SINGLE_SELECT "$BLOCKED_REASONS"

log "Creating flow-measurement fields"
create_field "Committed"   DATE   # cycle time starts — entry to Ready
create_field "Completed"   DATE   # cycle time stops  — entry to Done
create_field "Target Date" DATE   # Fixed Date class only

# ---------------------------------------------------------------------------
# Iteration field
# ---------------------------------------------------------------------------
#
# The two-week reporting boundary. gh project field-create does not support
# ITERATION, and createProjectV2Field rejects it on most accounts, so this is
# attempted and then handed off to the UI if it fails.

log "Creating the two-week Iteration field"

refresh_fields
if field_exists "Iteration"; then
  skip "Iteration"
elif $DRY_RUN; then
  ok "would attempt Iteration field (2-week duration)"
else
  PROJECT_ID=$(gh project view "$PROJECT_NUMBER" --owner "$OWNER" --format json | jq -r '.id')
  if gh api graphql -f query='
        mutation($projectId: ID!) {
          createProjectV2Field(input: {
            projectId: $projectId,
            dataType: ITERATION,
            name: "Iteration"
          }) { projectV2Field { ... on ProjectV2IterationField { id name } } }
        }' \
      -f projectId="$PROJECT_ID" >/dev/null 2>&1; then
    ok "Iteration created — confirm the duration is 2 weeks in the UI"
  else
    warn "Iteration fields cannot be created via the API on this account."
    warn "Create it manually: Project settings → + New field → Iteration → 2 weeks"
  fi
fi

# ---------------------------------------------------------------------------
# Optional repo link
# ---------------------------------------------------------------------------

if [[ -n "$LINK_REPO" ]]; then
  log "Linking repository $LINK_REPO"
  if $DRY_RUN; then
    ok "would link $LINK_REPO"
  else
    gh project link "$PROJECT_NUMBER" --owner "$OWNER" --repo "$LINK_REPO" >/dev/null 2>&1 \
      && ok "linked $LINK_REPO" \
      || warn "could not link $LINK_REPO"
  fi
fi

# ---------------------------------------------------------------------------
# What the API cannot do
# ---------------------------------------------------------------------------

cat <<EOF

$(printf '%s' "$c_bold")Board created: $PROJECT_URL$(printf '%s' "$c_reset")

The Projects v2 API has no mutations for views or column limits, so the
remaining setup is manual. It takes about ten minutes.

${c_bold}Views${c_reset}
  1. "Flow" — Board layout, group by ${c_bold}Status${c_reset}
       The daily working view.
  2. "Allocation" — Board layout, group by ${c_bold}Work Item Type${c_reset}
       The screenshot for the fortnightly report pack.
  3. "Aging WIP" — Table layout
       Filter: -status:Done,Triage
       Sort:   Committed ascending
       Oldest in-flight item sits at the top. Walk this at standup.
  4. "Commitments" — Roadmap layout
       Filter: class-of-service:"Fixed Date"
       Date fields: Committed → Target Date
  5. "Triage" — Table layout, filter: status:Triage
       Input queue for the weekly replenishment meeting.

${c_bold}WIP limits${c_reset} (Board view → ⋯ on each column → Set limit)
  In Progress ....... 1.5 × team size
  In Review ......... 3
  Ready ............. 2 × team size

  Expedite is limited to 1 system-wide. That is a policy, not a column
  setting — enforce it at replenishment.

${c_bold}Next${c_reset}
  Backfill 90 days of closed issues with Work Item Type before changing
  process. The baseline allocation chart is the artifact worth walking in
  with, and it comes from history you already have.

EOF
