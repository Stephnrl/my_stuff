inputs:
  - id: playbook
    name: Playbook
    description: Which playbook this stack will run, relative to the repo root
    type: select
    options:                        # CHANGE ME — your real playbook paths
      - site.yml
      - patching/monthly.yml
      - hardening/stig.yml
    validations:
      required: true

  - id: environment
    name: Environment
    description: Target environment. Prod requires manual approval before each run.
    type: select
    options: [dev, test, prod]
    default: dev
    validations:
      required: true

  - id: name_suffix
    name: Stack identifier
    description: Short name for this stack, e.g. "web-tier" or "db-patching"
    type: short_text
    validations:
      required: true
      min_length: 3
      max_length: 30
      pattern: "^[a-z0-9-]+$"

maps:
  dev:
    autodeploy: true
    subscription_id: 00000000-0000-0000-0000-0000000000dev   # CHANGE ME
  test:
    autodeploy: false
    subscription_id: 00000000-0000-0000-0000-000000000test   # CHANGE ME
  prod:
    autodeploy: false
    subscription_id: 00000000-0000-0000-0000-000000000prod   # CHANGE ME

stacks:
  - key: ansible
    name: ansible-${{ inputs.name_suffix }}-${{ inputs.environment }}
    description: Runs ${{ inputs.playbook }} against ${{ inputs.environment }}
    labels:
      - ansible
      - env/${{ inputs.environment }}
    autodeploy: ${{ maps[inputs.environment].autodeploy }}
    administrative: false
    worker_pool: 01JXXXXXXXXXXXXXXXXXXXXXXX                  # CHANGE ME

    vcs:
      provider: GITHUB
      namespace: your-org                                    # CHANGE ME
      repository: ansible-playbooks                          # CHANGE ME
      reference:
        value: main
        type: branch

    vendor:
      ansible:
        playbook: ${{ inputs.playbook }}

    environment:
      variables:
        - name: ARM_SUBSCRIPTION_ID
          value: ${{ maps[inputs.environment].subscription_id }}
        - name: ANSIBLE_CONFIG
          value: ansible.cfg

    attachments:
      contexts:
        - id: azure-gov-oidc                                 # CHANGE ME
          priority: 0
