---
# Expected AD domain, lowercase (e.g. "corp.example.us").
# Leave empty to skip the domain-membership assertion.
win_conn_check_expected_domain: ""

# Assert that the authentication package Windows actually used matches
# ansible_winrm_transport. Catches silent fallback from Kerberos to NTLM.
win_conn_check_verify_transport: true

# Gather a minimal set of Windows facts for the report.
# Set false if the service account lacks WMI read rights.
win_conn_check_gather_facts: true

# Seconds to allow for the initial win_ping before giving up.
win_conn_check_timeout: 30
